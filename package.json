{
  "name": "@3lineas/groovepack",
  "version": "1.1.0",
  "description": "Zero-dependency & modular infrastructure primitives for TypeScript, Cloudflare Workers (D1, Hono), React, and Astro.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/pipeline.d.ts",
      "import": "./dist/pipeline/pipeline.js"
    },
    "./pipeline/with-d1-transaction": {
      "types": "./dist/pipeline/with-d1-transaction.d.ts",
      "import": "./dist/pipeline/with-d1-transaction.js"
    },
    "./api-client": {
      "types": "./dist/api-client/index.d.ts",
      "import": "./dist/api-client/index.js"
    },
    "./api-action": {
      "types": "./dist/api-action/index.d.ts",
      "import": "./dist/api-action/index.js"
    },
    "./api-toast": {
      "types": "./dist/api-toast/index.d.ts",
      "import": "./dist/api-toast/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3-Lineas/GroovePack.git"
  },
  "homepage": "https://github.com/3-Lineas/GroovePack#readme",
  "bugs": {
    "url": "https://github.com/3-Lineas/GroovePack/issues"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run check-types && pnpm run build",
    "check-types": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "hono": ">=4.0.0",
    "sonner": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "hono": "^4.7.0",
    "sonner": "^2.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "groovepack",
    "hono",
    "cloudflare-d1",
    "pipeline",
    "logger",
    "api-client",
    "api-action",
    "sonner"
  ],
  "author": "3lineas",
  "license": "MIT"
}
