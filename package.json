{
  "name": "@3lineas/groovepack",
  "version": "0.1.2",
  "description": "Interactive CLI for sharing reusable library templates across projects without npm package clutter",
  "type": "module",
  "bin": {
    "groovepack": "dist/index.js"
  },
  "files": [
    "dist",
    "registry",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3-Lineas/GroovePack.git"
  },
  "homepage": "https://github.com/3-Lineas/GroovePack#readme",
  "bugs": {
    "url": "https://github.com/3-Lineas/GroovePack/issues"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "prepublishOnly": "pnpm run check-types && pnpm run build",
    "check-types": "tsc --noEmit",
    "test": "tsx test/rollback-and-install.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "cli",
    "scaffold",
    "code-sharing",
    "shadcn-style",
    "groovepack"
  ],
  "author": "3lineas",
  "license": "MIT"
}
