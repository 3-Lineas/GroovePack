### B. Drizzle ORM on D1 (`db`)

```typescript
import { Pipeline } from "@/lib/pipeline/pipeline";
import type { D1TransactionContext } from "@/lib/pipeline/types";
import { users } from "@/db/schema";
import { eq } from "drizzle-orm";
import type { BatchItem } from "drizzle-orm/batch";

interface CreateUserContext {
  db: typeof db;
  input: { email: string; name: string };
  tx?: D1TransactionContext<typeof db, BatchItem<"sqlite">>;
  createdId?: string;
}

async function validateUniqueEmail(ctx: CreateUserContext): Promise<CreateUserContext> {
  const [existing] = await ctx.tx!.db
    .select({ id: users.id })
    .from(users)
    .where(eq(users.email, ctx.input.email));

  if (existing) {
    throw new Error("Email already registered");
  }
  return ctx;
}

async function stageCreateUser(ctx: CreateUserContext): Promise<CreateUserContext> {
  const newId = crypto.randomUUID();

  // Stage Drizzle mutation
  ctx.tx!.stage(
    ctx.tx!.db.insert(users).values({
      id: newId,
      email: ctx.input.email,
      name: ctx.input.name,
    })
  );

  return { ...ctx, createdId: newId };
}

// Execute
const result = await Pipeline.send<CreateUserContext>({ db, input })
  .transactional(db)
  .through([validateUniqueEmail, stageCreateUser])
  .thenReturn();
```

