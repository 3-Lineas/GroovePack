## 2. How to Use

### A. Native Cloudflare D1 (`env.DB`)

```typescript
import { Pipeline } from "@/lib/pipeline/pipeline";
import type { D1TransactionContext } from "@/lib/pipeline/types";

interface CreateUserContext {
  db: D1Database;
  input: { email: string; name: string };
  tx?: D1TransactionContext<D1Database, D1PreparedStatement>;
  userId?: string;
}

// 1. Define isolated actions
async function ensureEmailAvailable(ctx: CreateUserContext): Promise<CreateUserContext> {
  const existing = await ctx.tx!.db
    .prepare("SELECT id FROM users WHERE email = ?")
    .bind(ctx.input.email)
    .first();

  if (existing) {
    throw new Error("Email already registered");
  }
  return ctx;
}

async function stageInsertUser(ctx: CreateUserContext): Promise<CreateUserContext> {
  const id = crypto.randomUUID();
  
  // Stage statement for atomic batch execution
  ctx.tx!.stage(
    ctx.tx!.db
      .prepare("INSERT INTO users (id, email, name) VALUES (?, ?, ?)")
      .bind(id, ctx.input.email, ctx.input.name)
  );

  return { ...ctx, userId: id };
}

// 2. Execute pipeline
const result = await Pipeline.send<CreateUserContext>({ db: env.DB, input })
  .transactional(env.DB)
  .through([ensureEmailAvailable, stageInsertUser])
  .then((ctx) => ({ id: ctx.userId! }));
```

