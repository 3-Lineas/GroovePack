### C. Pure In-Memory Workflows (No Database)

```typescript
import { Pipeline } from "@/lib/pipeline/pipeline";

interface TransformOrderContext {
  rawItems: Array<{ price: number; quantity: number }>;
  discountRate: number;
  subtotal?: number;
  total?: number;
}

const finalOrder = await Pipeline.send<TransformOrderContext>({
  rawItems: [{ price: 100, quantity: 2 }],
  discountRate: 0.1,
})
  .through([
    (ctx) => ({ ...ctx, subtotal: ctx.rawItems.reduce((acc, i) => acc + i.price * i.quantity, 0) }),
    (ctx) => ({ ...ctx, total: ctx.subtotal! * (1 - ctx.discountRate) }),
  ])
  .thenReturn();
```

